# ── Agent runtime artifacts ─────────────────────────────────────────
# runs/ = per-run journals, sessions/ = memory.py SESSIONS_DIR,
# workspace/ = tool sandbox output (plots/, finetune/, deployments/),
# knowledge/ = KnowledgeStore playbook.md + runs.db,
# artifacts/ = doc_intelligence annotated images (regenerable: rerun
#              `swarn doc-inspect` or examples/demo_doc_inspector.py)
/runs/
/artifacts/
/sessions/
/sandbox/
/workspace/
/knowledge/
agent/knowledge/
# stray runtime dirs created when a tool resolves a relative path from
# inside the package instead of the repo root (paths.py owns the real ones)
agent/workspace/
agent/runs/
agent/sessions/
# data_bridge scratch copies of uploaded/derived datasets
.swarn_datasets/
# dashboard uploads land in workspace/, but keep a top-level one ignored too
/uploads/

