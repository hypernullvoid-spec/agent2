# Copy this file to .env and adjust as needed.

# ── deployed model endpoint ──────────────────────────────────────────
# ALL LLM calls route to one deployed, OpenAI-compatible endpoint
# (BYO-LLM was removed — see agent/llm/router.py, "PRODUCTION ENDPOINT
# — CHANGE HERE"). Defaults point at the TEST deployment (Qwen 3.5 9B
# on Modal). TODO(production): set these to the production deployed
# model endpoint when it is ready — no code change needed.
SWARN_DEPLOYED_MODEL=nvidia/nemotron-3.5-lightning:free
SWARN_DEPLOYED_BASE_URL=https://openrouter.ai/api/v1
SWARN_DEPLOYED_API_KEY=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

# ── model display names (optional; routing ignores them) ─────────────
# SWARN_CODE_MODEL / SWARN_FEEDBACK_MODEL may be set to "mock:<name>"
# to run the search engine offline (tests do this). Any other value is
# a display label only — calls still hit the deployed endpoint.
# SWARN_CODE_MODEL=
# SWARN_FEEDBACK_MODEL=

# ── execution ────────────────────────────────────────────────────────
# SWARN_SANDBOX=docker|subprocess         # force; default: auto-detect
# SWARN_EXEC_TIMEOUT=300                  # per-call timeout (seconds)
# SWARN_SANDBOX_IMAGE=python:3.11-slim

# ── V3: search + learning ────────────────────────────────────────────
# SWARN_SEARCH_WORKERS=4                  # parallel solution nodes
# SWARN_KNOWLEDGE_DIR=./knowledge         # playbook + run archive location
# SWARN_MAX_ITERATIONS=30                 # ReAct loop iteration cap
# SWARN_CONTEXT_CHAR_BUDGET=400000        # compaction threshold (chars)
